{
  "name": "backpack-capsule",
  "version": "0.1.0",
  "description": "Convert between Digital Backpack organization.md files and CIDS (Common Impact Data Standard) impact data capsules.",
  "license": "MIT",
  "author": "Common Approach to Impact Measurement",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commonapproach/backpack-capsule.git"
  },
  "homepage": "https://github.com/commonapproach/backpack-capsule#readme",
  "bugs": {
    "url": "https://github.com/commonapproach/backpack-capsule/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "backpack-capsule": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test test/*.test.js",
    "convert": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cids",
    "common-approach",
    "digital-backpack",
    "json-ld",
    "impact-data"
  ],
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "optionalDependencies": {
    "@zazuko/env": "^2.2.0",
    "jsonld": "^8.3.2",
    "n3": "^1.17.4",
    "rdf-validate-shacl": "^0.5.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
